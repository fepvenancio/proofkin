# Copy to .env.local. `pnpm dev:chain` writes a working one for a local chain.
#
# PUBLIC settings: Next.js ships every NEXT_PUBLIC_ variable to the browser, so none of these may hold a secret.

# Which chain the contracts are on: anvil, baseSepolia or base.
NEXT_PUBLIC_CHAIN=baseSepolia
# What `forge script contracts/script/Deploy.s.sol` printed.
NEXT_PUBLIC_PROOFKIN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RENDERER=0x0000000000000000000000000000000000000000
# The block the collection was deployed in (or a block just before it); the leaderboard reads events from here.
NEXT_PUBLIC_DEPLOY_BLOCK=0
# A public RPC endpoint for the browser. Leave blank to use the chain's default one.
NEXT_PUBLIC_RPC_URL=
# Seconds per block, for countdowns. Leave blank for the chain's usual one.
NEXT_PUBLIC_BLOCK_TIME=
# A WalletConnect (Reown) project id, which is public by design. Without one only browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# SERVER-ONLY settings: never shipped to the browser.
#
# The RPC endpoint server components read the chain through; a keyed provider URL belongs here, not above.
RPC_URL=
