# Copy to .env.local and fill in. `pnpm dev:chain` writes a working .env.local for a local chain.
#
# anvil | baseSepolia | base
VITE_CHAIN=baseSepolia
# Optional: defaults to the chain's public RPC. Use your own for anything busy.
# VITE_RPC_URL=https://sepolia.base.org
VITE_PROOFKIN=0x0000000000000000000000000000000000000000
VITE_RENDERER=0x0000000000000000000000000000000000000000
# Block the collection was deployed in: where the gallery starts reading events.
VITE_DEPLOY_BLOCK=0
# Optional: seconds per block, for the wait estimates. Defaults to 1 on anvil and 2 on Base.
# VITE_BLOCK_TIME=2
