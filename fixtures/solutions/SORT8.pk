# SORT8: Batcher odd-even merge sort, 19 compare-exchange steps.
# Each step turns two wires into (min, max): 8 IN + 19*2 = 46 nodes.
puzzle SORT8
x0 = IN 0
x1 = IN 1
x2 = IN 2
x3 = IN 3
x4 = IN 4
x5 = IN 5
x6 = IN 6
x7 = IN 7
lo1 = MIN x0 x1
hi1 = MAX x0 x1
lo2 = MIN x2 x3
hi2 = MAX x2 x3
lo3 = MIN x4 x5
hi3 = MAX x4 x5
lo4 = MIN x6 x7
hi4 = MAX x6 x7
lo5 = MIN lo1 lo2
hi5 = MAX lo1 lo2
lo6 = MIN hi1 hi2
hi6 = MAX hi1 hi2
lo7 = MIN lo3 lo4
hi7 = MAX lo3 lo4
lo8 = MIN hi3 hi4
hi8 = MAX hi3 hi4
lo9 = MIN lo6 hi5
hi9 = MAX lo6 hi5
lo10 = MIN lo8 hi7
hi10 = MAX lo8 hi7
lo11 = MIN lo5 lo7
hi11 = MAX lo5 lo7
lo12 = MIN lo9 lo10
hi12 = MAX lo9 lo10
lo13 = MIN hi9 hi10
hi13 = MAX hi9 hi10
lo14 = MIN hi6 hi8
hi14 = MAX hi6 hi8
lo15 = MIN lo13 hi11
hi15 = MAX lo13 hi11
lo16 = MIN lo14 hi12
hi16 = MAX lo14 hi12
lo17 = MIN lo12 lo15
hi17 = MAX lo12 lo15
lo18 = MIN lo16 hi15
hi18 = MAX lo16 hi15
lo19 = MIN hi16 hi13
hi19 = MAX hi16 hi13
out lo11 lo17 hi17 lo18 hi18 lo19 hi19 hi14
